{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ai-coder",
  "version": "0.1.0",
  "identifier": "ai.sendhub.ai-coder",
  "build": {
    "frontendDist": "../desktop/launcher"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ai-coder",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop shell for ai-coder"
  }
}
