# -------- Local Postgres + PostgREST (required) --------
# Homebrew Postgres (port 5433 by default) is the database. Run `npm run
# db:setup` once, then `npm run dev` — it starts PostgREST on 5434 too.
DATABASE_URL=postgresql://YOUR_OS_USER@127.0.0.1:5433/ai_coder
POSTGREST_URL=http://127.0.0.1:5434
# Shared HS256 secret. PostgREST verifies it; the backend signs user tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
POSTGREST_JWT_SECRET=replace-me

# Supabase-shaped clients talk to local PostgREST. The frontend URL is the app
# origin; Vite/Hono proxies /rest/v1. Any non-empty anon key works locally.
VITE_SUPABASE_URL=http://localhost:5173
VITE_SUPABASE_ANON_KEY=local-anon-key
SUPABASE_URL=http://127.0.0.1:5434
# Optional. server/local-auth.ts signs a service JWT from POSTGREST_JWT_SECRET
# when this is omitted. If set, it must be a JWT with role=service_role.
# SUPABASE_SERVICE_ROLE_KEY=

# -------- AnyOAuth (required for login) --------
# Create a project at https://anyoauth.com/dashboard with the exact callback:
#   http://localhost:5173/auth/callback
ANYOAUTH_CLIENT_ID=app_...
ANYOAUTH_CLIENT_SECRET=aosk_...
ANYOAUTH_ORIGIN=http://localhost:5173

# -------- Admin (required for self-hosted) --------
# Only this email is allowed to sign in. All other users get 403.
ADMIN_EMAIL=you@example.com

# -------- LLM provider (optional) --------
# Selects which provider drives the agent loop. Default: claude-code-sdk.
# `opencode` is built and tested but opt-in; see docs/LLM-PROVIDER.md.
# LLM_PROVIDER=claude-code-sdk

# -------- OpenCode runtime (opt-in) --------
# Only used when LLM_PROVIDER=opencode. The provider embeds OpenCode in-process.
# OPENCODE_MODEL=deepseek/deepseek-flash
# OPENCODE_PROVIDER=deepseek            # used for bare model ids
# OPENCODE_DATA_DIR=/path/to/opencode-data
# OPENCODE_CONFIG_CONTENT={"$schema":"https://opencode.ai/config.json",...}

# -------- Anthropic (prod only) --------
# In local dev, leave this unset — the server deletes ANTHROPIC_API_KEY at startup
# so the Claude CLI falls back to subscription OAuth (run `claude /login` once).
# In production (Railway), set this to a real API key.
# ANTHROPIC_API_KEY=sk-ant-...

# -------- DeepSeek via the Anthropic-compatible endpoint (optional) --------
# Runs the existing Claude Agent SDK against DeepSeek. No runtime change.
# Use ANTHROPIC_AUTH_TOKEN (not ANTHROPIC_API_KEY) so dev does not delete it.
# Leave ANTHROPIC_BASE_URL unset to stay on Anthropic / Claude subscription OAuth.
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-...
# ANTHROPIC_MODEL=deepseek-flash[1m]
# ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash[1m]
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
# ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
# CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash
# CLAUDE_CODE_EFFORT_LEVEL=max
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432

# -------- Integrations encryption (required) --------
# AES-256-GCM key for encrypting stored provider tokens (e.g. GitHub OAuth tokens).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_KEY=base64-encoded-32-byte-key

# -------- Filesystem (optional, with defaults) --------
# Sandbox for the directory browser. Defaults to the parent of process.cwd()
# if unset. Projects must live under this path.
# PROJECTS_ROOT=/Users/you/code

# Where per-task git worktrees are created. Defaults to a sibling of PROJECTS_ROOT.
# WORKTREES_ROOT=/Users/you/code/.ai-coder-worktrees

# Workspace dir for temporary files (chat uploads, etc).
# WORKSPACE_DIR=/tmp/ai-coder

# -------- Server (optional, with defaults) --------
# HOST=0.0.0.0
# PORT=3001
# NODE_ENV=development
# SHELL=/bin/zsh

# -------- Runtime supervisor (optional) --------
# Cap on concurrently-running dev services per user.
# RUNTIME_MAX_SERVICES_PER_USER=10
# Port range for auto-assigned service ports.
# RUNTIME_PORT_RANGE=4000-4999
